# Skopiuj ten plik do .env w tym samym katalogu (backend/.env).
# Windows, z katalogu projektu: copy backend\.env_tmpl backend\.env
# Linux, z katalogu projektu: cp backend/.env_tmpl backend/.env
# Uzupelnij backend/.env prawdziwymi danymi. Nie dodawaj go do Git.
# Po zmianie konfiguracji uruchom start-test.bat, aby kontener ja wczytal.

SMTP_HOST=poczta.dimundi.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=biuro@dimundi.com
SMTP_PASS=change-me
MAIL_FROM=Dimundi <biuro@dimundi.com>
MAIL_TO=biuro@dimundi.com
CONTACT_EMAIL=biuro@dimundi.com
CONTACT_PHONE=+48 123 456 789
