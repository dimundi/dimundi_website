# Public production defaults, updated by install.bat.
# Passwords, Turnstile keys and contact details belong in backend/.env on the VPS.
# Values in that private file override these defaults.
PORT=3000
CORS_ORIGIN=https://dimundi.com
SMTP_HOST=poczta.dimundi.com
SMTP_PORT=587
SMTP_SECURE=false
TURNSTILE_HOSTNAMES=dimundi.com
