# Public configuration only. Accounts/password hashes are stored on the VPS.
TZ=Europe/Warsaw
SSL_TYPE=letsencrypt
SSL_DOMAIN=poczta.dimundi.com
POSTMASTER_ADDRESS=marcin@dimundi.com
POSTFIX_INET_PROTOCOLS=ipv4
DOVECOT_INET_PROTOCOLS=ipv4
PERMIT_DOCKER=none
SPOOF_PROTECTION=1
ENABLE_POP3=0
ENABLE_IMAP=1
ENABLE_FAIL2BAN=1
ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=1
RSPAMD_LEARN=1
ENABLE_CLAMAV=1
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_POSTGREY=0
POSTFIX_MESSAGE_SIZE_LIMIT=52428800
